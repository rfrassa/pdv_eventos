# Copiar este archivo como .env y completar los valores reales.
# El archivo .env NUNCA se sube a git.

# Clave secreta de Django — generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiar-por-clave-generada

# 1 = modo desarrollo (debug activado), 0 = producción
DJANGO_DEBUG=1

# IP del servidor en la red local del evento (ej: 192.168.0.10)
# Las terminales/tablets apuntan a esta IP para acceder al PDV
PDV_SERVER_IP=192.168.x.x
